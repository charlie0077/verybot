                          "id": "olpbL",
                          "name": "abText",
                          "fill": "$--foreground",
                          "content": "Here are the key trends in AI agents for 2025:\n\n1. Multi-agent orchestration — systems where specialized agents collaborate on complex tasks\n2. Tool-augmented reasoning — agents that use tools like browsers, code execution, and APIs\n3. Long-term memory — persistent memory across sessions using embeddings\n4. Autonomous scheduling — agents that proactively run tasks on cron schedules",
                          "lineHeight": 1.5,
                          "fontFamily": "Noto Sans",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
